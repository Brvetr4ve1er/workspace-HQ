{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veemo.local/schema/workspace-scan.schema.json",
  "title": "Workspace Scan",
  "description": "Canonical machine-readable record emitted by each periodic workspace checkup. One instance per scan, written as a JSON sidecar next to the human Markdown report. The WorkspaceHQ desktop app reads every 'Workspace Status *.json' to build history, trends, quests, and gamification state. This file is the single source of truth; the .md report is a rendered human view of the same data.",
  "type": "object",
  "required": ["schema_version", "scan", "account", "projects", "quests", "trends", "changes_since_prev", "inventory"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0", "description": "Bump on breaking schema changes; the app migrates older instances." },

    "scan": {
      "type": "object",
      "description": "Metadata about this scan run.",
      "required": ["id", "date", "mode"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "YYYY-MM-DD (one scan per day; suffix -N for multiple runs/day)." },
        "date": { "type": "string", "format": "date-time" },
        "mode": { "enum": ["manual", "nightly", "on-demand", "git-hook"] },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "previous_scan": { "type": ["string", "null"], "description": "id of the scan this one diffs against." },
        "enriched": { "type": "boolean", "description": "True when the LLM enrichment pass contributed to this scan (gates '~est.' UI hints)." },
        "enrichment_scan_id": { "type": ["string", "null"], "description": "Scan id the carried-forward enrichment.json was produced for (null when none)." },
        "enrichment_age_days": { "type": ["integer", "null"], "minimum": 0, "description": "Days between that enrichment and this scan; >1 means insights/completion are carried forward, not fresh." },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "collector": { "type": "string", "description": "Deterministic collector version (git/files/grep)." },
            "enricher": { "type": ["string", "null"], "description": "LLM model used for insights/suggestions/roadmaps, or null if facts-only run." }
          }
        }
      }
    },

    "account": {
      "type": "object",
      "description": "Workspace-wide gamification rollup (the 'player' across all projects).",
      "required": ["level", "xp", "health_index", "totals"],
      "additionalProperties": false,
      "properties": {
        "level": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "description": "Flavor rank for the current level (from gamification.config.json)." },
        "xp": { "type": "integer", "minimum": 0, "description": "Cumulative XP across all projects + quests + streaks." },
        "xp_into_level": { "type": "integer", "minimum": 0 },
        "xp_to_next": { "type": "integer", "minimum": 0 },
        "health_index": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Composite 0-100 workspace health (formula in gamification.config.json)." },
        "health_delta": { "type": "integer", "description": "health_index change vs previous scan." },
        "streak": { "$ref": "#/$defs/streak" },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "products": { "type": "integer" },
            "vaults": { "type": "integer" },
            "clones": { "type": "integer" },
            "trivial": { "type": "integer" },
            "open_quests": { "type": "integer" },
            "red_quests": { "type": "integer" },
            "quests_done_total": { "type": "integer" },
            "achievements_unlocked": { "type": "integer" },
            "open_side_quests": { "type": "integer" },
            "archived": { "type": "integer" },
            "learnings": { "type": "integer", "description": "Entries captured in the What I Learned log." },
            "knowledge_xp": { "type": "integer", "description": "Separate knowledge track: learnings * per-lesson XP." }
          }
        },
        "daily_top3": {
          "type": "array",
          "description": "Deterministic daily focus picks (quick_win / momentum / rescue).",
          "items": {
            "type": "object",
            "required": ["kind", "label"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "description": "quick_win | momentum | rescue." },
              "label": { "type": "string" },
              "project_id": { "type": ["string", "null"] },
              "quest_id": { "type": ["string", "null"] },
              "reason": { "type": "string" }
            }
          }
        },
        "spellcraft": {
          "type": "object",
          "description": "Spellbook economy rollup: collection meters, mastery (distinct-days), settlement watermark. Absent until the spellbook scanner has run.",
          "additionalProperties": false,
          "properties": {
            "spells_known": { "type": "integer" },
            "familiars_bound": { "type": "integer" },
            "ever_cast": { "type": "integer" },
            "ever_cast_pct": { "type": "integer" },
            "per_school": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": { "known": { "type": "integer" }, "cast": { "type": "integer" }, "pct": { "type": "integer" } }
              }
            },
            "lifetime_casts": { "type": "integer" },
            "mastery": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": { "rank": { "type": "string" }, "distinct_days": { "type": "integer" } }
              }
            },
            "sotd_casts": { "type": "integer", "description": "Lifetime count of Spell-of-the-Day bonus casts." },
            "spell_of_day": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" }, "name": { "type": "string" }, "icon": { "type": ["string", "null"] },
                "school": { "type": "string" }, "rarity": { "type": "string" }, "bonus_xp": { "type": "integer" }
              }
            },
            "last_processed_at": { "type": "string", "description": "Settlement watermark — casts at or before this are already counted." },
            "xp_settled_this_scan": { "type": "integer" }
          }
        }
      }
    },

    "achievements": {
      "type": "array",
      "description": "Snapshot of achievement state at this scan (catalog defined in gamification.config.json).",
      "items": { "$ref": "#/$defs/achievement_state" }
    },

    "projects": {
      "type": "array",
      "description": "One entry per ORIGINAL PRODUCT (user code). Clones/vaults/trivial live in 'inventory' instead.",
      "items": { "$ref": "#/$defs/project" }
    },

    "archived_projects": {
      "type": "array",
      "description": "Products the user shelved via project-overrides.json; kept out of scoring but listed in the Graveyard.",
      "items": { "type": "object" }
    },

    "recent_learnings": {
      "type": "array",
      "description": "Last ~10 entries from the What I Learned log (newest first).",
      "items": { "type": "object" }
    },

    "side_quests": {
      "type": "array",
      "description": "Flattened global side-quest feed (risk/urgent/idea propositions + brain-dump captures), capped ~40.",
      "items": { "$ref": "#/$defs/side_quest" }
    },

    "quests": {
      "type": "array",
      "description": "Cross-project quest board. Quests are derived from TODOs/risks; each carries an attached insight and evidence so the dashboard can show WHY it exists. State persists across scans (open -> in_progress -> done/dismissed) by matching quest id.",
      "items": { "$ref": "#/$defs/quest" }
    },

    "trends": {
      "type": "object",
      "description": "Curated time-series for graphs. Deliberately minimal: only series that drive a decision. Each is an array of dated points so the app draws a line/bar without recomputation.",
      "additionalProperties": false,
      "properties": {
        "health_index": { "type": "array", "items": { "$ref": "#/$defs/trend_point" }, "description": "Overall workspace health over time." },
        "completion_by_project": {
          "type": "object",
          "description": "project_id -> dated completion% points. Drives the per-project progress lines.",
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/trend_point" } }
        },
        "open_quests_by_tier": {
          "type": "array",
          "description": "Stacked bar: red/orange/yellow open quest counts over time. Shows whether debt is shrinking.",
          "items": {
            "type": "object",
            "required": ["d"],
            "properties": {
              "d": { "type": "string", "format": "date" },
              "red": { "type": "integer" }, "orange": { "type": "integer" }, "yellow": { "type": "integer" }
            }
          }
        },
        "git_risk": {
          "type": "array",
          "description": "Count of repos at high/medium/low git-safety risk over time.",
          "items": {
            "type": "object",
            "required": ["d"],
            "properties": {
              "d": { "type": "string", "format": "date" },
              "high": { "type": "integer" }, "medium": { "type": "integer" }, "low": { "type": "integer" }
            }
          }
        },
        "xp": { "type": "array", "items": { "$ref": "#/$defs/trend_point" }, "description": "Cumulative account XP over time (the 'are I leveling up' line)." },
        "knowledge_xp": { "type": "array", "items": { "$ref": "#/$defs/trend_point" }, "description": "Cumulative knowledge-track XP (learnings) over time." },
        "casts_per_day": { "type": "array", "items": { "$ref": "#/$defs/trend_point" }, "description": "Spells cast per day (raw count from telemetry, incl. fizzles)." }
      }
    },

    "changes_since_prev": {
      "type": "array",
      "description": "Explicit, typed diff vs the previous scan. Powers the 'Changes' feed and notifications. Empty array = nothing moved.",
      "items": { "$ref": "#/$defs/change" }
    },

    "browser": {
      "type": "object",
      "description": "Optional WorkspaceHQ Bridge rollup. It is a scan-time snapshot of local browser activity; scans from before the bridge may omit it.",
      "required": ["captured", "updated", "current", "by_domain", "by_project", "totals"],
      "additionalProperties": false,
      "properties": {
        "captured": { "type": "boolean" },
        "updated": { "type": ["string", "null"], "format": "date-time" },
        "current": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "domain": { "type": "string" },
            "host": { "type": "string" },
            "title": { "type": "string" },
            "url": { "type": "string" },
            "focus_ms": { "type": "number", "minimum": 0 },
            "project_id": { "type": ["string", "null"] },
            "live": { "type": "boolean" }
          }
        },
        "by_domain": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["domain", "focus_ms", "visits", "last_ts", "title"],
            "additionalProperties": false,
            "properties": {
              "domain": { "type": "string" },
              "focus_ms": { "type": "number", "minimum": 0 },
              "visits": { "type": "integer", "minimum": 0 },
              "last_ts": { "type": "number", "minimum": 0 },
              "title": { "type": "string" }
            }
          }
        },
        "by_project": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["project_id", "project_name", "focus_ms", "visits", "domains"],
            "additionalProperties": false,
            "properties": {
              "project_id": { "type": "string" },
              "project_name": { "type": "string" },
              "focus_ms": { "type": "number", "minimum": 0 },
              "visits": { "type": "integer", "minimum": 0 },
              "domains": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "totals": {
          "type": "object",
          "required": ["focus_ms", "visits", "domains"],
          "additionalProperties": false,
          "properties": {
            "focus_ms": { "type": "number", "minimum": 0 },
            "visits": { "type": "integer", "minimum": 0 },
            "domains": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },

    "inventory": {
      "type": "object",
      "description": "Cheap classification of everything that is NOT a tracked product.",
      "additionalProperties": false,
      "properties": {
        "vaults": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" }, "notes": { "type": "integer" }, "role": { "type": "string" },
              "recent7": { "type": "integer", "description": "Notes touched in the last 7 days." },
              "stale90": { "type": "integer", "description": "Notes untouched for 90+ days." },
              "kb": { "type": "integer", "description": "Vault size in KB." },
              "source": { "enum": ["config", "registry", "scan"], "description": "How the vault was found: hand-configured, Obsidian's own registry, or a .obsidian folder under the scan root." },
              "path": { "type": "string", "description": "Path relative to the scan root (absolute when outside it)." },
              "embedded_in": { "type": ["string", "null"], "description": "Product id whose folder contains this vault, if any." }
            }
          }
        },
        "unclassified": {
          "type": "array",
          "description": "Folders under the scan root that are not a tracked product/vault/clone and not ignored. Facts only — the user decides what each is.",
          "items": { "$ref": "#/$defs/folder_facts" }
        },
        "ignored": {
          "type": "array",
          "description": "Folders the collector config says not to score. Still listed so nothing is invisible.",
          "items": { "$ref": "#/$defs/folder_facts" }
        },
        "loose_files": {
          "type": "array",
          "description": "Files sitting directly in the scan root (zips, bundles, stray notes), largest first.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "bytes": { "type": "number", "minimum": 0 }, "days_since_modified": { "type": "integer" } }
          }
        },
        "clones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" }, "origin": { "type": "string" }, "dirty": { "type": "integer" },
              "diverged": { "type": "boolean", "description": "Has local modifications vs upstream." }
            }
          }
        },
        "trivial": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "note": { "type": "string" } }
          }
        },
        "empty": { "type": "array", "items": { "type": "string" }, "description": "Folder names with no real content (cleanup candidates)." },
        "anomalies": {
          "type": "array",
          "description": "Things that need a human eyeball (e.g. a referenced prototype that vanished).",
          "items": {
            "type": "object",
            "required": ["type", "detail", "severity"],
            "properties": {
              "type": { "type": "string" },
              "detail": { "type": "string" },
              "severity": { "enum": ["info", "warning", "danger"] }
            }
          }
        },
        "duplicates": {
          "type": "array",
          "description": "Detected twin/duplicate project folders.",
          "items": {
            "type": "object",
            "required": ["type", "detail", "severity"],
            "properties": {
              "type": { "type": "string" },
              "detail": { "type": "string" },
              "severity": { "enum": ["info", "warning", "danger"] }
            }
          }
        }
      }
    }
  },

  "$defs": {
    "folder_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "enum": ["empty", "vault", "project-like", "other"] },
        "stack": { "type": "array", "items": { "type": "string" }, "description": "Marker-file stack guess (Node, Next.js, Python, Static HTML…)." },
        "has_git": { "type": "boolean" },
        "remote": { "type": ["string", "null"] },
        "dirty": { "type": "integer", "minimum": 0 },
        "unpushed": { "type": "boolean" },
        "files": { "type": "integer", "minimum": 0, "description": "Shallow file count (depth 3, capped at 3000)." },
        "last_modified": { "type": ["string", "null"], "format": "date" },
        "days_since_modified": { "type": ["integer", "null"] }
      }
    },
    "streak": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scan_days": { "type": "integer", "minimum": 0, "description": "Consecutive days a scan ran." },
        "longest_scan_days": { "type": "integer", "minimum": 0 },
        "last_scan": { "type": "string", "format": "date" }
      }
    },

    "trend_point": {
      "type": "object",
      "required": ["d", "v"],
      "additionalProperties": false,
      "properties": {
        "d": { "type": "string", "format": "date" },
        "v": { "type": "number" }
      }
    },

    "project": {
      "type": "object",
      "required": ["id", "name", "kind", "path", "completion", "metrics", "activity"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "kebab-case stable id (survives renames where possible)." },
        "name": { "type": "string" },
        "kind": { "const": "product" },
        "path": { "type": "string" },
        "stack": { "type": "array", "items": { "type": "string" } },
        "dev_cmd": { "type": ["string", "null"], "description": "Command the dashboard uses to launch this project's dev server." },
        "canonical_branch": { "type": ["string", "null"] },
        "signals": {
          "type": "object",
          "description": "Cheap deterministic presence checks (no builds are actually run).",
          "additionalProperties": false,
          "properties": {
            "has_tests": { "type": "boolean" },
            "test_files": { "type": "integer" },
            "has_build_config": { "type": "boolean" },
            "build_script": { "type": ["string", "null"] },
            "test_script": { "type": ["string", "null"] },
            "has_readme": { "type": "boolean" },
            "has_license": { "type": "boolean" },
            "has_ci": { "type": "boolean" },
            "has_dockerfile": { "type": "boolean" },
            "has_package_json": { "type": "boolean" },
            "dep_count": { "type": ["integer", "null"] }
          }
        },
        "disk": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reclaimable_bytes": { "type": "integer" },
            "fat_dirs": { "type": "array", "items": { "type": "object" } }
          }
        },
        "side_quests": { "type": "array", "items": { "$ref": "#/$defs/side_quest" } },

        "completion": {
          "type": "object",
          "required": ["pct"],
          "additionalProperties": false,
          "properties": {
            "pct": { "type": "integer", "minimum": 0, "maximum": 100 },
            "basis": { "type": "string", "description": "1-line justification (LLM-judged)." },
            "delta": { "type": "integer", "description": "pct change vs previous scan." }
          }
        },

        "level": { "type": "integer", "minimum": 1 },
        "xp": { "type": "integer", "minimum": 0 },
        "xp_delta": { "type": "integer" },
        "xp_breakdown": {
          "type": "object",
          "description": "How this project's score was earned this scan (deterministic, per gamification.config.json).",
          "additionalProperties": { "type": "number" }
        },

        "activity": {
          "type": "object",
          "required": ["state"],
          "additionalProperties": false,
          "properties": {
            "state": { "enum": ["active", "stale", "dormant"] },
            "last_commit": { "type": ["string", "null"], "format": "date" },
            "days_since_commit": { "type": ["integer", "null"] },
            "commit_cadence_7d": { "type": ["integer", "null"], "description": "Commits in last 7 days." }
          }
        },

        "metrics": {
          "type": "object",
          "description": "The four tracked dimensions. All deterministic except completion (LLM-judged).",
          "required": ["code_health", "git_safety", "activity", "risk_security"],
          "additionalProperties": false,
          "properties": {
            "code_health": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "build": { "enum": ["green", "red", "runs", "unknown"] },
                "build_note": { "type": "string" },
                "tests": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "present": { "type": "boolean" },
                    "count": { "type": ["integer", "null"] },
                    "passing": { "type": ["integer", "null"] },
                    "status": { "type": "string" }
                  }
                },
                "todo_fixme": { "type": ["integer", "null"], "minimum": 0 },
                "files": { "type": ["integer", "null"] },
                "loc": { "type": ["integer", "null"] },
                "loc_delta": { "type": ["integer", "null"] },
                "recent_files": { "type": "array", "items": { "type": "string" }, "description": "Most recently modified source files (re-entry aid)." }
              }
            },
            "git_safety": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "has_git": { "type": "boolean" },
                "has_remote": { "type": "boolean" },
                "remote": { "type": ["string", "null"] },
                "branch": { "type": ["string", "null"] },
                "commits": { "type": "integer" },
                "dirty": { "type": "integer", "description": "Uncommitted files (git status --porcelain)." },
                "ahead": { "type": "integer" },
                "behind": { "type": "integer" },
                "unpushed": { "type": "boolean" },
                "risk": { "enum": ["low", "medium", "high"] },
                "flags": { "type": "array", "items": { "type": "string" }, "description": "e.g. no-commits, no-remote, many-dirty, detached-head." },
                "last_commit_subject": { "type": ["string", "null"] }
              }
            },
            "activity": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": { "enum": ["active", "stale", "dormant"] },
                "last_modified": { "type": ["string", "null"], "format": "date" }
              }
            },
            "risk_security": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "score": { "enum": ["low", "medium", "high"] },
                "secrets_found": { "type": "integer", "minimum": 0 },
                "stale_deps": { "type": "boolean" },
                "flags": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type", "severity", "detail"],
                    "additionalProperties": false,
                    "properties": {
                      "type": { "type": "string", "description": "e.g. exposed_admin, missing_auth, hardcoded_secret, runtime_crash." },
                      "severity": { "enum": ["low", "medium", "high"] },
                      "detail": { "type": "string" },
                      "location": { "type": "string", "description": "file:line where applicable." }
                    }
                  }
                }
              }
            }
          }
        },

        "insights": { "type": "array", "items": { "$ref": "#/$defs/insight" } },
        "suggestions": { "type": "array", "items": { "$ref": "#/$defs/suggestion" } },
        "roadmap": { "type": "array", "items": { "$ref": "#/$defs/roadmap_milestone" } },
        "quest_ids": { "type": "array", "items": { "type": "string" }, "description": "Quests anchored to this project (full objects live in top-level 'quests')." }
      }
    },

    "insight": {
      "type": "object",
      "required": ["id", "text", "severity"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string", "description": "One sharp sentence. LLM-generated, evidence-backed." },
        "severity": { "enum": ["info", "warning", "danger"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "object", "description": "Deterministic facts that justify the insight (so it's never a hallucination)." },
        "linked_quest_ids": { "type": "array", "items": { "type": "string" } }
      }
    },

    "suggestion": {
      "type": "object",
      "required": ["text", "effort", "impact"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "kind": { "type": "string", "description": "Suggestion category (e.g. quick_win, hygiene, growth)." },
        "effort": { "enum": ["S", "M", "L"] },
        "impact": { "enum": ["low", "medium", "high"] },
        "linked_quest_id": { "type": ["string", "null"] }
      }
    },

    "roadmap_milestone": {
      "type": "object",
      "required": ["milestone", "status"],
      "additionalProperties": false,
      "properties": {
        "milestone": { "type": "string" },
        "status": { "enum": ["planned", "in_progress", "done"] },
        "target": { "type": ["string", "null"], "format": "date" },
        "items": { "type": "array", "items": { "type": "string" } },
        "progress_pct": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }
      }
    },

    "quest": {
      "type": "object",
      "required": ["id", "title", "tier", "status", "xp"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "Stable id so state survives across scans (e.g. q-etoile-commit)." },
        "title": { "type": "string" },
        "project_id": { "type": ["string", "null"], "description": "null = workspace-level quest." },
        "tier": { "enum": ["red", "orange", "yellow"], "description": "Priority -> also determines XP reward." },
        "status": { "enum": ["open", "in_progress", "done", "dismissed"] },
        "xp": { "type": "integer", "minimum": 0 },
        "insight": { "type": "string", "description": "The 'why' attached to the quest (user requested insights on quests)." },
        "evidence": { "type": "object", "description": "Deterministic facts; the engine flips status->done automatically when evidence resolves (e.g. dirty==0)." },
        "auto_complete_when": { "type": "string", "description": "Human-readable rule the engine evaluates to auto-close, e.g. 'commits>0 && has_remote'." },
        "created": { "type": "string", "format": "date" },
        "completed": { "type": ["string", "null"], "format": "date" },
        "carried_from": { "type": ["string", "null"], "format": "date", "description": "First scan this quest appeared; powers an 'age/persistence' nag." },
        "age_days": { "type": "integer", "minimum": 0 },
        "reopened_from": { "type": "string", "description": "Id of the done quest whose condition returned; this quest is its re-raise (id carries a -rN suffix)." }
      }
    },

    "change": {
      "type": "object",
      "required": ["type", "detail", "impact"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "description": "e.g. git_pushed, repo_initialized, build_flip, quest_completed, quest_unresolved, new_project, project_removed, anomaly, level_up, new_achievement, spell_learned, spell_mastery_up, spell_of_day_cast, spellcraft_xp." },
        "project_id": { "type": ["string", "null"] },
        "quest_id": { "type": ["string", "null"] },
        "detail": { "type": "string" },
        "impact": { "enum": ["positive", "negative", "neutral"] },
        "notify": { "type": "boolean", "description": "Whether the desktop app should fire a tray notification." },
        "achievement_id": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "xp": { "type": "integer" },
        "level": { "type": "integer" },
        "title": { "type": "string" }
      }
    },

    "side_quest": {
      "type": "object",
      "required": ["id", "title", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "project_id": { "type": ["string", "null"] },
        "project_name": { "type": "string" },
        "kind": { "type": "string", "description": "risk | urgent | idea | capture." },
        "title": { "type": "string" },
        "detail": { "type": "string" },
        "source": { "type": "string", "description": "deterministic | llm | capture." },
        "effort": { "enum": ["S", "M", "L"] },
        "impact": { "enum": ["low", "medium", "high"] },
        "severity": { "enum": ["info", "warning", "danger", "low", "medium", "high"] },
        "done": { "type": "boolean" },
        "completed": { "type": ["string", "null"], "format": "date" },
        "reclaim_bytes": { "type": "integer", "description": "Disk-reclaim side-quests: bytes freeable." },
        "fat_dirs": { "type": "array", "items": { "type": "object" }, "description": "Disk-reclaim side-quests: the regenerable dirs." }
      }
    },

    "achievement_state": {
      "type": "object",
      "required": ["id", "unlocked"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "unlocked": { "type": "boolean" },
        "unlocked_on": { "type": ["string", "null"], "format": "date" },
        "project_id": { "type": ["string", "null"] },
        "progress": {
          "type": "object",
          "description": "For incremental achievements.",
          "additionalProperties": false,
          "properties": { "have": { "type": "number" }, "need": { "type": "number" } }
        }
      }
    }
  }
}
