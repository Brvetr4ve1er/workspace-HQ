# MAPS HQ runs locally, served by WorkspaceHQ's bridge under /world/. Nothing here is a secret.
# Basemap (pick at most one; with none set, OpenFreeMap tiles are used: free, no key).
# Your own Protomaps .pmtiles file (e.g. served next to the map, or on your own storage):
VITE_PMTILES_URL=
# Or the Protomaps hosted API key:
VITE_PROTOMAPS_KEY=
# Or no basemap at all (just the city of your work on a dark field, no outside requests for tiles):
# VITE_BASEMAP=none
