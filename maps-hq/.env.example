# --- Basemap (pick ONE; with none set, the app falls back to OpenFreeMap's free "dark" style) ---
# Protomaps hosted API key (https://protomaps.com/account) -> dark flavor via @protomaps/basemaps
VITE_PROTOMAPS_KEY=
# Or your own .pmtiles on R2/S3 (e.g. https://cdn.example.com/planet.pmtiles); takes priority over the key
VITE_PMTILES_URL=
# Or MapTiler (https://cloud.maptiler.com/account/keys) -> "dataviz-dark" style
VITE_MAPTILER_KEY=

# --- Supabase (owned POI base + progress). Publishable/anon key only: never the service role here. ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (ingest scripts / edge functions). NEVER prefix with VITE_. ---
SUPABASE_SERVICE_ROLE_KEY=
FOURSQUARE_API_KEY=
# Google Places: live on-screen lookups only, never written to the DB (ToS). Restrict by HTTP referrer.
VITE_GOOGLE_MAPS_KEY=
