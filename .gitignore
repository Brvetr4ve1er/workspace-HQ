# --- dev / preview artifacts ---
dashboard/_*.png
dashboard/_*.js
dashboard/_console.txt
fix_*.png
.playwright-mcp/
# v3 parity screenshots (regenerated by legacy/dashboard-v3/tools/parity-shot-*.js)
legacy/dashboard-v3/tools/shots/
# v4 verify screenshots (regenerated by D-phase offscreen harnesses)
legacy/dashboard-v4/tools/shots/

# renderer flag (runtime, owner-owned, main-readable): "v2" | "v3" | "v4" loads that
# quarantined renderer from legacy/ (rollback); missing or anything else = v5.
# Written by tools\rollback.ps1 <vN>.
data/.ui-version

# THE CANVAS (M3): user/Familiar shared boards — personal content, stays local
data/canvas/

# --- OS noise ---
Thumbs.db
desktop.ini
.DS_Store

# capture inbox (transient)
data/brain-dump.json

# organic-UI runtime state (positions of live desktop shards)
data/shards.json
data/shard-library.json

# browser bridge runtime state (active-tab focus from the extension) + its token
# and (2026-11-07, Bridge 0.7.0) its pairing record. Patterns: a crashed atomic write leaves <name>.<pid>.tmp.
data/browser-activity.json
data/.bridge-token*
data/.bridge-pairing.json*

# Claude Hub index — every Claude Code session + claude.ai chat (local, private; never commit)
data/claude/

# social bridge: scraped feeds/mentions/metrics, the post outbox, connected
# accounts, and any cached session material — personal content, never committed
data/social/
data/.social/

# now-brief: regenerated each run by tools/now-brief.mjs (Claude-on-tap context)
data/now-brief.md

# --- external / vendored repos (kept on disk, out of git) ---
Understand-Anything/

# pc-health vitals + rolling history (runtime, machine-specific, regenerated each scan)
data/pc-health.json
data/pc-health-history.json
data/pc-health-disk.json
# GitHub account snapshot (collector/github.mjs) — holds private repo names and PR titles; never commit
data/github.json
# Vercel / Supabase account snapshot (collector/accounts.mjs) — private project names; never commit
data/accounts.json

# trailer render tool: renders, masters, stills (tools/trailer/out) and the patched work copy + Electron profile (tools/trailer/.work)
tools/trailer/out/
tools/trailer/.work/

# money space + Operator Brief (2026-11-05): owner money data, and the brief derived from personal scan data.
# data/ is NOT ignored wholesale here, so each owner file needs its own line.
# (2026-11-07) the brief files became patterns: a crashed atomic write leaves data/brief.json.<pid>.tmp.
data/money/
data/brief.json*
data/brief-state.json*

# kitchen batch 1 (2026-11-07): the assistant's names-only call log (+ its .1 rotation), the scan lock the app
# and a session's raw pass share, and client delivery checklists (+ .corrupt quarantines). Patterns, for temp files too.
data/assistant-audit.jsonl*
data/.refresh.lock*
data/delivery.json*
# Cosmos space (key 0): library, curation, thumbnails, imports and clips — the owner's own files, never committed
data/cosmos/
