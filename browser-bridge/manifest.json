{
  "manifest_version": 3,
  "name": "WorkspaceHQ Bridge",
  "version": "0.1.0",
  "description": "Streams what you're working on (active-tab focus) to your local WorkspaceHQ app, and gives Claude context on your browser.",
  "permissions": ["tabs", "storage", "alarms", "idle"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WorkspaceHQ Bridge",
    "default_icon": "icon128.png"
  },
  "icons": { "128": "icon128.png" }
}
